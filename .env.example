# Example environment configuration for PlantSense AI
# Copy this file to .env and adjust values as needed.
# Lines starting with # are comments and are ignored by the loader.

HOST=127.0.0.1          # Flask bind address
PORT=5001               # Flask port (default)
FLASK_DEBUG=0           # Set to 1 to enable debug mode (development only)
CORS_ORIGIN=*           # Allowed CORS origin (use specific domain in production)
DEMO_MODE=1             # 1 = use simulated data, 0 = read from serial hardware
SERIAL_PORT=            # e.g., /dev/cu.usbserial-1140 (leave empty if not using hardware)
SERIAL_BAUD=9600        # Baud rate for serial communication
SERIAL_TIMEOUT=1.0      # Serial read timeout in seconds
API_URL=http://127.0.0.1:5001  # Base URL used by the frontend to reach the Flask backend
